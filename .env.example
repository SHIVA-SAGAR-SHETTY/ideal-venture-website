# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Resend (https://resend.com) API key used by the quote form.
RESEND_API_KEY=

# Where enquiries are delivered (comma-separate multiple addresses).
ENQUIRY_TO_EMAIL=pradeepklshetty@gmail.com

# Sender address. Leave unset to use Resend's test sender until the domain is verified in Resend,
# then set e.g. "Ideal Venture Website <enquiry@idealventurebuilding.com>".
# ENQUIRY_FROM_EMAIL=

# Public URL of the site (used for canonical URLs, sitemap and social previews).
NEXT_PUBLIC_SITE_URL=https://idealventurebuilding.com
